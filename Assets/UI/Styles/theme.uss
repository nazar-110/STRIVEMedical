/* 
    theme.uss
    Translated from styles/theme.css
    Place at: Assets/UI/Styles/theme.uss
    This is imported by every screen's USS file.
*/

/* ── Root variables (USS uses custom properties differently from CSS) ─────── */
/* USS does not support CSS variables the same way — colours are defined       */
/* as reusable classes instead.                                                 */

/* ── Base screen ─────────────────────────────────────────────────────────── */
.screen {
    width: 100%;
    height: 100%;
    background-color: rgb(249, 250, 251); /* bg-gray-50 */
    flex-direction: column;
}

.screen-dark {
    background-color: rgb(17, 24, 39); /* bg-gray-900 */
}

/* ── Typography ──────────────────────────────────────────────────────────── */
.text-xs    { font-size: 11px; }
.text-sm    { font-size: 13px; }
.text-base  { font-size: 15px; }
.text-lg    { font-size: 17px; }
.text-xl    { font-size: 20px; }
.text-2xl   { font-size: 24px; }
.text-3xl   { font-size: 30px; }
.text-4xl   { font-size: 36px; }
.text-9xl   { font-size: 96px; }

.font-medium  { -unity-font-style: normal; }
.font-semibold { -unity-font-style: bold; }
.font-bold    { -unity-font-style: bold; }
.font-mono    { font-size: 13px; }

/* ── Colours ─────────────────────────────────────────────────────────────── */
/* Primary greens — from ThemeContext.tsx colorSchemes */
.color-primary       { color: rgb(52, 76, 61); }   /* #344C3D evergreen */
.color-accent        { color: rgb(142, 165, 140); } /* #8EA58C sage */
.bg-primary          { background-color: rgb(52, 76, 61); }
.bg-accent           { background-color: rgb(142, 165, 140); }
.bg-accent-light     { background-color: rgb(191, 207, 187); } /* #BFCFBB */

/* Grays */
.bg-gray-50          { background-color: rgb(249, 250, 251); }
.bg-gray-100         { background-color: rgb(243, 244, 246); }
.bg-gray-200         { background-color: rgb(229, 231, 235); }
.bg-gray-700         { background-color: rgb(55, 65, 81); }
.bg-gray-800         { background-color: rgb(31, 41, 55); }
.bg-gray-900         { background-color: rgb(17, 24, 39); }
.text-gray-400       { color: rgb(156, 163, 175); }
.text-gray-500       { color: rgb(107, 114, 128); }
.text-gray-600       { color: rgb(75, 85, 99); }
.text-white          { color: rgb(255, 255, 255); }
.text-black          { color: rgb(0, 0, 0); }

/* Status */
.bg-green-100        { background-color: rgb(220, 252, 231); }
.bg-green-500        { background-color: rgb(34, 197, 94); }
.text-green-500      { color: rgb(34, 197, 94); }
.text-green-600      { color: rgb(22, 163, 74); }
.bg-blue-100         { background-color: rgb(219, 234, 254); }
.bg-blue-600         { background-color: rgb(37, 99, 235); }
.text-blue-600       { color: rgb(37, 99, 235); }
.bg-yellow-50        { background-color: rgb(254, 252, 232); }
.text-yellow-800     { color: rgb(133, 77, 14); }
.bg-red-500          { background-color: rgb(239, 68, 68); }
.text-red-600        { color: rgb(220, 38, 38); }
.bg-orange-100       { background-color: rgb(255, 237, 213); }
.text-orange-600     { color: rgb(234, 88, 12); }

/* ── Layout utilities ────────────────────────────────────────────────────── */
.flex-row            { flex-direction: row; }
.flex-col            { flex-direction: column; }
.flex-1              { flex-grow: 1; flex-shrink: 1; }
.flex-wrap           { flex-wrap: wrap; }
.items-center        { align-items: center; }
.items-start         { align-items: flex-start; }
.justify-center      { justify-content: center; }
.justify-between     { justify-content: space-between; }
.justify-end         { justify-content: flex-end; }

/* Gaps */
.gap-1  { margin-right: 4px; }
.gap-2  { margin-right: 8px; }
.gap-3  { margin-right: 12px; }
.gap-4  { margin-right: 16px; }

/* Padding */
.p-2    { padding: 8px; }
.p-3    { padding: 12px; }
.p-4    { padding: 16px; }
.p-6    { padding: 24px; }
.px-3   { padding-left: 12px; padding-right: 12px; }
.px-6   { padding-left: 24px; padding-right: 24px; }
.py-1   { padding-top: 4px; padding-bottom: 4px; }
.py-2   { padding-top: 8px; padding-bottom: 8px; }
.pt-20  { padding-top: 80px; }

/* Margin */
.mb-2   { margin-bottom: 8px; }
.mb-3   { margin-bottom: 12px; }
.mb-4   { margin-bottom: 16px; }
.mb-6   { margin-bottom: 24px; }
.mt-1   { margin-top: 4px; }
.mt-4   { margin-top: 16px; }
.ml-7   { margin-left: 28px; }
.mx-auto { margin-left: auto; margin-right: auto; }

/* Sizing */
.w-full { width: 100%; }
.h-full { height: 100%; }
.w-3    { width: 12px; }
.w-4    { width: 16px; }
.w-5    { width: 20px; }
.w-6    { width: 24px; }
.w-8    { width: 32px; }
.w-16   { width: 64px; }
.w-20   { width: 80px; }
.w-32   { width: 128px; }
.h-2    { height: 8px; }
.h-3    { height: 12px; }
.h-4    { height: 16px; }
.h-5    { height: 20px; }
.h-8    { height: 32px; }
.h-20   { height: 80px; }
.max-w-md   { max-width: 448px; }
.max-w-2xl  { max-width: 672px; }
.max-w-7xl  { max-width: 1280px; }

/* Border radius */
.rounded     { border-radius: 4px; }
.rounded-md  { border-radius: 6px; }
.rounded-lg  { border-radius: 8px; }
.rounded-xl  { border-radius: 12px; }
.rounded-full { border-radius: 9999px; }

/* Borders */
.border      { border-width: 1px; border-color: rgb(229, 231, 235); }
.border-2    { border-width: 2px; }
.border-b    { border-bottom-width: 1px; border-bottom-color: rgb(229, 231, 235); }
.border-gray-200 { border-color: rgb(229, 231, 235); }
.border-red-300  { border-color: rgb(252, 165, 165); }
.border-blue-200 { border-color: rgb(191, 219, 254); }

/* ── Card ────────────────────────────────────────────────────────────────── */
.card {
    background-color: rgb(255, 255, 255);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(229, 231, 235);
    padding: 0;
}

.card-header {
    padding: 20px 24px 0 24px;
}

.card-title {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    color: rgb(17, 24, 39);
}

.card-content {
    padding: 16px 24px 24px 24px;
    flex-direction: column;
}

/* ── Top bar ─────────────────────────────────────────────────────────────── */
.top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    background-color: rgb(249, 250, 251);
    border-bottom-width: 1px;
    border-bottom-color: rgb(229, 231, 235);
    position: relative;
    height: 72px;
    flex-shrink: 0;
}

.top-bar-left  { flex-direction: row; align-items: center; }
.top-bar-right { flex-direction: row; align-items: center; }

/* ── Buttons ─────────────────────────────────────────────────────────────── */
.btn {
    border-radius: 6px;
    padding: 10px 16px;
    font-size: 14px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
}

.btn-primary {
    background-color: rgb(52, 76, 61);
    color: rgb(255, 255, 255);
    border-width: 0;
}

.btn-primary:hover {
    background-color: rgb(40, 60, 48);
}

.btn-accent {
    background-color: rgb(142, 165, 140);
    color: rgb(255, 255, 255);
    border-width: 0;
}

.btn-accent:hover {
    background-color: rgb(122, 145, 121);
}

.btn-outline {
    background-color: transparent;
    color: rgb(17, 24, 39);
    border-width: 1px;
    border-color: rgb(229, 231, 235);
}

.btn-outline:hover {
    background-color: rgb(243, 244, 246);
}

.btn-outline-red {
    background-color: transparent;
    color: rgb(220, 38, 38);
    border-width: 1px;
    border-color: rgb(252, 165, 165);
}

.btn-outline-blue {
    background-color: transparent;
    color: rgb(37, 99, 235);
    border-width: 1px;
    border-color: rgb(191, 219, 254);
}

.btn-blue {
    background-color: rgb(37, 99, 235);
    color: rgb(255, 255, 255);
    border-width: 0;
}

.btn-ghost {
    background-color: transparent;
    border-width: 0;
    color: rgb(75, 85, 99);
}

.btn-ghost:hover {
    background-color: rgb(243, 244, 246);
}

.btn-icon {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.btn-lg {
    padding: 14px 24px;
    font-size: 16px;
    height: 52px;
}

.btn-sm {
    padding: 6px 12px;
    font-size: 12px;
    height: 32px;
}

.btn-full { width: 100%; }

/* ── Input fields ────────────────────────────────────────────────────────── */
.input-field {
    height: 44px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(209, 213, 219);
    background-color: rgb(255, 255, 255);
    padding: 0 12px;
    font-size: 14px;
    color: rgb(17, 24, 39);
    width: 100%;
}

.input-field:focus {
    border-color: rgb(142, 165, 140);
}

.input-field .unity-base-text-field__input {
    border-width: 0;
    background-color: transparent;
    margin: 0;
    padding-left: 12px;
    padding-right: 12px;
}

.input-field .unity-text-field__input {
    border-width: 0;
    background-color: transparent;
    margin: 0;
}

/* ── Progress bar ────────────────────────────────────────────────────────── */
.progress-track {
    height: 8px;
    border-radius: 4px;
    background-color: rgb(229, 231, 235);
    width: 100%;
    overflow: hidden;
}

.progress-fill {
    height: 8px;
    border-radius: 4px;
    background-color: rgb(142, 165, 140);
}

/* ── Tabs ────────────────────────────────────────────────────────────────── */
.tab-bar {
    flex-direction: row;
    background-color: rgb(243, 244, 246);
    border-radius: 8px;
    padding: 4px;
    margin-bottom: 16px;
}

.tab-btn {
    flex: 1;
    height: 36px;
    border-radius: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    border-width: 0;
    background-color: transparent;
    color: rgb(107, 114, 128);
    align-items: center;
    justify-content: center;
}

.tab-btn--active {
    background-color: rgb(255, 255, 255);
    color: rgb(17, 24, 39);
}

/* ── Slider ──────────────────────────────────────────────────────────────── */
.unity-slider__tracker {
    background-color: rgb(229, 231, 235);
    height: 6px;
    border-radius: 3px;
}

.unity-slider__dragger {
    background-color: rgb(52, 76, 61);
    width: 20px;
    height: 20px;
    border-radius: 10px;
    top: -7px;
}

/* ── Badge/pill ──────────────────────────────────────────────────────────── */
.badge {
    border-radius: 9999px;
    padding: 4px 12px;
    font-size: 12px;
    -unity-font-style: bold;
}

.badge-green {
    background-color: rgb(142, 165, 140);
    color: rgb(255, 255, 255);
}

.badge-blue {
    background-color: rgb(37, 99, 235);
    color: rgb(255, 255, 255);
}

/* ── Status dot ──────────────────────────────────────────────────────────── */
.status-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
}

.status-connected    { background-color: rgb(52, 76, 61); }
.status-disconnected { background-color: rgb(239, 68, 68); }

/* ── Divider ─────────────────────────────────────────────────────────────── */
.divider {
    height: 1px;
    background-color: rgb(229, 231, 235);
    margin: 8px 0;
}

/* ── Scroll view ─────────────────────────────────────────────────────────── */
.scroll-content {
    flex-direction: column;
    padding: 24px;
    padding-top: 88px;
}
