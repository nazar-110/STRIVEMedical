<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!--
        SimulatorHUD.uxml
        Place at: Assets/UI/Screens/SimulatorHUD/SimulatorHUD.uxml
        Attach via UIDocument on a GameObject in the NewToolSimulator scene.
        The USS references theme.uss — make sure Panel Settings includes it,
        or add the style sheet reference below.
    -->

    <!-- Root — transparent so the 3D scene shows through -->
    <ui:VisualElement name="hud-root" style="
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0; left: 0;
        flex-direction: column;
        background-color: rgba(0,0,0,0);
        pointer-events: none;
    ">

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  TOP BAR                                                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <ui:VisualElement name="hud-topbar" style="
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            padding-top: 14px;
            padding-bottom: 14px;
            padding-left: 24px;
            padding-right: 24px;
            background-color: rgba(17, 24, 39, 0.82);
            flex-shrink: 0;
            height: 68px;
            pointer-events: auto;
        ">
            <!-- LEFT: Logo -->
            <ui:VisualElement name="hud-top-left" style="flex-direction: row; align-items: center; width: 220px;">
                <ui:VisualElement name="hud-logo" style="
                    width: 140px;
                    height: 20px;
                    background-image: url('project://database/Assets/UI/Sprites/strive-logo.png');
                "/>
            </ui:VisualElement>

            <!-- CENTER: Progress bar + label -->
            <ui:VisualElement name="hud-top-center" style="flex-grow: 1; align-items: center; max-width: 560px;">
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 6px;">
                    <ui:Label name="module-name-label" text="Demo" style="
                        font-size: 13px;
                        color: rgb(156, 163, 175);
                        margin-right: 12px;
                    "/>
                    <ui:Label name="progress-pct-label" text="45%" style="
                        font-size: 14px;
                        -unity-font-style: bold;
                        color: rgb(142, 165, 140);
                    "/>
                </ui:VisualElement>
                <!-- Progress track -->
                <ui:VisualElement name="hud-progress-track" style="
                    width: 100%;
                    height: 8px;
                    background-color: rgba(255,255,255,0.12);
                    border-radius: 4px;
                    overflow: hidden;
                ">
                    <ui:VisualElement name="hud-progress-fill" style="
                        height: 100%;
                        width: 45%;
                        background-color: rgb(142, 165, 140);
                        border-radius: 4px;
                    "/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- RIGHT: Arm status + exit -->
            <ui:VisualElement name="hud-top-right" style="flex-direction: row; align-items: center; width: 220px; justify-content: flex-end;">
                <ui:VisualElement name="arm-pill" style="
                    flex-direction: row;
                    align-items: center;
                    border-width: 1px;
                    border-color: rgba(255,255,255,0.2);
                    border-radius: 20px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    padding-left: 12px;
                    padding-right: 12px;
                    margin-right: 14px;
                ">
                    <ui:VisualElement name="arm-dot" style="
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background-color: rgb(122, 170, 110);
                        margin-right: 7px;
                    "/>
                    <ui:Label name="arm-status-label" text="Arm Connected" style="
                        font-size: 12px;
                        color: rgb(209, 213, 219);
                    "/>
                </ui:VisualElement>

                <ui:Button name="exit-btn" text="Exit" style="
                    background-color: rgba(220,38,38,0.18);
                    border-width: 1px;
                    border-color: rgba(220,38,38,0.5);
                    border-radius: 8px;
                    color: rgb(252, 165, 165);
                    font-size: 13px;
                    -unity-font-style: bold;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    padding-left: 18px;
                    padding-right: 18px;
                "/>
            </ui:VisualElement>
        </ui:VisualElement>


        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  MIDDLE AREA — fills remaining space, panels float here        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <ui:VisualElement name="hud-middle" style="flex-grow: 1; position: relative; pointer-events: none;">

            <!-- ─────────────────────────────────────────────────────────── -->
            <!--  STEP-COMPLETE BANNER — slides in center-top, then fades   -->
            <!--  Driven entirely by SimulatorHUDController.CompleteCurrentStep() -->
            <!-- ─────────────────────────────────────────────────────────── -->
            <ui:VisualElement name="step-complete-banner" style="
                position: absolute;
                top: 28px;
                left: 0; right: 0;
                align-items: center;
                display: none;
                pointer-events: none;
                opacity: 1;
            ">
                <ui:VisualElement style="
                    flex-direction: row;
                    align-items: center;
                    background-color: rgba(30, 50, 38, 0.96);
                    border-width: 1px;
                    border-color: rgba(142, 165, 140, 0.55);
                    border-radius: 14px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: 24px;
                    padding-right: 24px;
                ">
                    <!-- Green checkmark circle -->
                    <ui:VisualElement style="
                        width: 28px; height: 28px;
                        border-radius: 14px;
                        background-color: rgb(34, 197, 94);
                        align-items: center;
                        justify-content: center;
                        margin-right: 12px;
                        flex-shrink: 0;
                    ">
                        <ui:Label text="✓" style="font-size: 14px; -unity-font-style: bold; color: rgb(255,255,255);"/>
                    </ui:VisualElement>

                    <!-- Text column -->
                    <ui:VisualElement>
                        <ui:Label text="STEP COMPLETE" style="
                            font-size: 10px;
                            -unity-font-style: bold;
                            color: rgb(142, 165, 140);
                            letter-spacing: 2px;
                            margin-bottom: 2px;
                        "/>
                        <ui:Label name="step-banner-label" text="Hold position for 5 seconds" style="
                            font-size: 15px;
                            -unity-font-style: bold;
                            color: rgb(243, 244, 246);
                            white-space: normal;
                        "/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- ─────────────────────────────────────────────────────────── -->


            <!-- TASK PANEL — bottom-left, always visible -->
            <ui:VisualElement name="task-panel" style="
                position: absolute;
                bottom: 100px;
                left: 24px;
                width: 340px;
                background-color: rgba(17, 24, 39, 0.88);
                border-radius: 14px;
                border-width: 1px;
                border-color: rgba(255,255,255,0.10);
                overflow: hidden;
                pointer-events: auto;
            ">
                <!-- Task panel header -->
                <ui:VisualElement name="task-header" style="
                    flex-direction: row;
                    align-items: center;
                    justify-content: space-between;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    padding-left: 18px;
                    padding-right: 18px;
                    border-bottom-width: 1px;
                    border-bottom-color: rgba(255,255,255,0.08);
                ">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="☰" style="font-size: 14px; color: rgb(142,165,140); margin-right: 8px;"/>
                        <ui:Label text="Current Task" style="font-size: 14px; -unity-font-style: bold; color: rgb(243,244,246);"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label name="task-counter-label" text="3 / 5" style="font-size: 12px; color: rgb(156,163,175); margin-right: 10px;"/>
                        <ui:Button name="tasks-toggle-btn" text="▼" style="
                            background-color: transparent;
                            border-width: 0;
                            color: rgb(156,163,175);
                            font-size: 12px;
                            padding: 0;
                            width: 24px;
                            height: 24px;
                        "/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Current step highlight -->
                <ui:VisualElement name="current-step-box" style="
                    flex-direction: row;
                    align-items: flex-start;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    padding-left: 18px;
                    padding-right: 18px;
                    background-color: rgba(52, 76, 61, 0.35);
                    border-bottom-width: 1px;
                    border-bottom-color: rgba(255,255,255,0.06);
                ">
                    <ui:VisualElement style="
                        width: 28px; height: 28px;
                        border-radius: 14px;
                        background-color: rgb(52, 76, 61);
                        align-items: center;
                        justify-content: center;
                        margin-right: 12px;
                        flex-shrink: 0;
                        margin-top: 1px;
                    ">
                        <ui:Label name="current-step-num" text="3" style="font-size: 12px; -unity-font-style: bold; color: rgb(255,255,255);"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1;">
                        <ui:Label name="current-step-label" text="Hold position for 5 seconds" style="
                            font-size: 14px;
                            -unity-font-style: bold;
                            color: rgb(243, 244, 246);
                            white-space: normal;
                            margin-bottom: 4px;
                        "/>
                        <ui:Label name="current-step-detail" text="Keep the instrument steady at the target location until the timer completes." style="
                            font-size: 12px;
                            color: rgb(156, 163, 175);
                            white-space: normal;
                        "/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Expandable full task list -->
                <ui:VisualElement name="task-list-expanded" style="display: none;">
                    <!-- Populated by SimulatorHUDController.cs -->
                    <ui:VisualElement name="task-list-container" style="
                        padding-top: 8px;
                        padding-bottom: 8px;
                        padding-left: 18px;
                        padding-right: 18px;
                        max-height: 220px;
                    "/>
                </ui:VisualElement>
            </ui:VisualElement>


            <!-- HINT PANEL — bottom-right, toggleable -->
            <ui:VisualElement name="hint-panel" style="
                position: absolute;
                bottom: 100px;
                right: 24px;
                width: 300px;
                background-color: rgba(17, 24, 39, 0.88);
                border-radius: 14px;
                border-width: 1px;
                border-color: rgba(255,255,255,0.10);
                padding-top: 16px;
                padding-bottom: 16px;
                padding-left: 18px;
                padding-right: 18px;
                display: none;
                pointer-events: auto;
            ">
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 14px;">
                    <ui:Label text="💡" style="font-size: 16px; margin-right: 8px;"/>
                    <ui:Label text="Hints &amp; Tips" style="font-size: 14px; -unity-font-style: bold; color: rgb(243,244,246); flex-grow: 1;"/>
                    <ui:Button name="hints-close-btn" text="×" style="
                        background-color: transparent;
                        border-width: 0;
                        color: rgb(156,163,175);
                        font-size: 18px;
                        padding: 0;
                        width: 24px; height: 24px;
                    "/>
                </ui:VisualElement>
                <ui:VisualElement name="hint-list-container"/>
                <ui:VisualElement style="
                    background-color: rgba(254,252,232,0.10);
                    border-radius: 8px;
                    padding-top: 10px; padding-bottom: 10px;
                    padding-left: 12px; padding-right: 12px;
                    margin-top: 10px;
                ">
                    <ui:Label text="💡 Consistency is key. Controlled movements yield better scores." style="
                        font-size: 12px;
                        color: rgb(253, 224, 71);
                        white-space: normal;
                    "/>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>


        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  BOTTOM BAR — live stats + toolbar                             -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <ui:VisualElement name="hud-bottombar" style="
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            padding-top: 0;
            padding-bottom: 0;
            padding-left: 24px;
            padding-right: 24px;
            background-color: rgba(17, 24, 39, 0.82);
            flex-shrink: 0;
            height: 72px;
            pointer-events: auto;
        ">
            <!-- Live stats -->
            <ui:VisualElement name="live-stats" style="flex-direction: row; align-items: center;">

                <ui:VisualElement name="stat-reps" style="
                    flex-direction: column;
                    align-items: center;
                    margin-right: 32px;
                ">
                    <ui:Label name="stat-reps-val" text="5 / 10" style="font-size: 22px; -unity-font-style: bold; color: rgb(243,244,246);"/>
                    <ui:Label text="Repetitions" style="font-size: 11px; color: rgb(107,114,128);"/>
                </ui:VisualElement>

                <ui:VisualElement style="width: 1px; height: 36px; background-color: rgba(255,255,255,0.10); margin-right: 32px;"/>

                <ui:VisualElement name="stat-time" style="
                    flex-direction: column;
                    align-items: center;
                    margin-right: 32px;
                ">
                    <ui:Label name="stat-time-val" text="0:00" style="font-size: 22px; -unity-font-style: bold; color: rgb(243,244,246);"/>
                    <ui:Label text="Time Elapsed" style="font-size: 11px; color: rgb(107,114,128);"/>
                </ui:VisualElement>

                <ui:VisualElement style="width: 1px; height: 36px; background-color: rgba(255,255,255,0.10); margin-right: 32px;"/>

                <ui:VisualElement name="stat-accuracy" style="
                    flex-direction: column;
                    align-items: center;
                ">
                    <ui:Label name="stat-accuracy-val" text="92%" style="font-size: 22px; -unity-font-style: bold; color: rgb(142,165,140);"/>
                    <ui:Label text="Accuracy" style="font-size: 11px; color: rgb(107,114,128);"/>
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- Exercise name centre -->
            <ui:Label name="exercise-name-label" text="Needle Targeting" style="
                font-size: 16px;
                -unity-font-style: bold;
                color: rgb(209,213,219);
                -unity-text-align: middle-center;
                flex-grow: 1;
            "/>

            <!-- Toolbar buttons -->
            <ui:VisualElement name="hud-toolbar" style="flex-direction: row; align-items: center;">
                <ui:Button name="home-btn" text="Home" style="
                    height: 42px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: rgba(142,165,140,0.5);
                    background-color: rgba(142,165,140,0.14);
                    color: rgb(209,213,219);
                    font-size: 13px;
                    -unity-font-style: bold;
                    padding-left: 16px;
                    padding-right: 16px;
                    margin-left: 8px;
                "/>
                <ui:Button name="pause-btn" text="⏸" style="
                    width: 42px; height: 42px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: rgba(255,255,255,0.15);
                    background-color: rgba(255,255,255,0.06);
                    color: rgb(209,213,219);
                    font-size: 16px;
                    margin-left: 8px;
                "/>
                <ui:Button name="hints-btn" text="💡" style="
                    width: 42px; height: 42px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: rgba(255,255,255,0.15);
                    background-color: rgba(255,255,255,0.06);
                    font-size: 16px;
                    margin-left: 8px;
                "/>
                <ui:Button name="complete-btn" text="Complete ✓" style="
                    height: 42px;
                    border-radius: 10px;
                    border-width: 0;
                    background-color: rgb(52, 76, 61);
                    color: rgb(255,255,255);
                    font-size: 13px;
                    -unity-font-style: bold;
                    padding-left: 20px;
                    padding-right: 20px;
                    margin-left: 12px;
                "/>
            </ui:VisualElement>
        </ui:VisualElement>


        <ui:VisualElement name="completion-countdown-overlay" style="
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(10, 14, 23, 0.78);
            align-items: center;
            justify-content: center;
            flex-direction: column;
            display: none;
            z-index: 998;
            pointer-events: auto;
        ">
            <ui:Label text="Returning Home" style="
                font-size: 18px;
                -unity-font-style: bold;
                color: rgb(209,213,219);
                letter-spacing: 2px;
                margin-bottom: 14px;
            "/>
            <ui:Label name="completion-countdown-label" text="3" style="
                font-size: 104px;
                -unity-font-style: bold;
                color: rgb(142,165,140);
                -unity-text-align: middle-center;
            "/>
        </ui:VisualElement>

        <!-- PAUSED OVERLAY — full screen -->
        <ui:VisualElement name="paused-overlay" style="
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(10, 14, 23, 0.72);
            align-items: center;
            justify-content: center;
            flex-direction: column;
            display: none;
            z-index: 999;
            pointer-events: auto;
        ">
            <ui:Label text="⏸" style="font-size: 64px; color: rgb(255,255,255); margin-bottom: 12px;"/>
            <ui:Label text="PAUSED" style="
                font-size: 28px;
                -unity-font-style: bold;
                color: rgb(243,244,246);
                letter-spacing: 6px;
                margin-bottom: 8px;
            "/>
            <ui:Label text="Press pause again to resume" style="font-size: 14px; color: rgb(107,114,128);"/>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
