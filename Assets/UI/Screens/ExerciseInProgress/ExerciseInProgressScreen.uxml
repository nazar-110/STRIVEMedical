<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- ExerciseInProgressScreen.uxml | Translated from: app/pages/ExerciseInProgress.tsx -->
    <!-- Place at: Assets/UI/Screens/ExerciseInProgress/ExerciseInProgressScreen.uxml -->
    <Style src="../../Styles/theme.uss" />
    <ui:VisualElement name="exercise-in-progress-screen" class="screen">

        <ui:VisualElement name="top-bar" class="top-bar">
            <ui:VisualElement name="logo-image" style="width: 140px; height: 20px; background-image: url('project://database/Assets/UI/Sprites/strive-logo.png');"/>
            <ui:VisualElement name="top-bar-right" style="flex-direction: row; align-items: center;">
                <ui:VisualElement name="notification-button-slot"/>
                <ui:VisualElement name="arm-status-slot" style="margin-left: 12px;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView style="flex-grow: 1; padding-top: 80px;">
            <ui:VisualElement style="padding: 24px; flex-direction: column; max-width: 1280px;">

                <!-- Exercise header -->
                <ui:VisualElement style="margin-bottom: 24px;">
                    <ui:Label name="exercise-name-text" text="Shoulder Flexion" class="text-3xl font-bold" style="margin-bottom: 8px; color: rgb(17,24,39);"/>
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label name="module-label" text="Module 1" class="text-sm" style="color: rgb(75,85,99); margin-right: 16px;"/>
                        <ui:Label name="progress-text" text="Progress: 45%" class="text-sm" style="color: rgb(75,85,99); margin-right: 8px;"/>
                        <ui:VisualElement class="progress-track" style="width: 128px;">
                            <ui:VisualElement name="progress-fill" class="progress-fill" style="width: 45%;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Two-column layout -->
                <ui:VisualElement style="flex-direction: row;">

                    <!-- Left 2/3 — main exercise area -->
                    <ui:VisualElement style="flex: 2; margin-right: 24px; flex-direction: column;">
                        <ui:VisualElement class="card">
                            <ui:VisualElement class="card-content" style="padding: 0; flex-direction: column;">

                                <!-- Visualization area — your 3D arm renders here -->
                                <ui:VisualElement name="visualization-area"
                                    style="background-color: rgb(243,244,246); height: 400px; align-items: center; justify-content: center; position: relative; overflow: hidden;">

                                    <!-- Paused overlay -->
                                    <ui:VisualElement name="paused-overlay"
                                        style="position: absolute; top: 0; left: 0; right: 0; bottom: 0;
                                               background-color: rgba(0,0,0,0.4); align-items: center; justify-content: center; display: none;">
                                        <ui:Label text="Exercise Paused" style="color: white; font-size: 18px; -unity-font-style: bold;"/>
                                        <ui:Label text="Click Play to continue" style="color: rgba(255,255,255,0.7); font-size: 13px; margin-top: 8px;"/>
                                    </ui:VisualElement>

                                    <!-- Placeholder content (replace with your 3D viewport) -->
                                    <ui:VisualElement style="align-items: center;">
                                        <ui:VisualElement style="width: 128px; height: 128px; border-radius: 64px; background-color: rgb(142,165,140); align-items: center; justify-content: center; margin-bottom: 16px;">
                                            <ui:Label text="🦾" style="font-size: 48px;"/>
                                        </ui:VisualElement>
                                        <ui:Label name="status-label" text="Exercise in Progress" style="color: rgb(75,85,99);"/>
                                    </ui:VisualElement>

                                    <!-- Floating action buttons — bottom right -->
                                    <ui:VisualElement style="position: absolute; bottom: 16px; right: 16px; flex-direction: row;">
                                        <ui:Button name="zoom-button" text="⊕" class="btn btn-outline btn-icon" style="margin-right: 8px; background-color: white;"/>
                                        <ui:Button name="pause-play-button" text="⏸" class="btn btn-outline btn-icon" style="margin-right: 8px; background-color: white;"/>
                                        <ui:Button name="task-list-button" text="☰" class="btn btn-outline btn-icon" style="margin-right: 8px; background-color: white;"/>
                                        <ui:Button name="info-button" text="ℹ" class="btn btn-outline btn-icon" style="background-color: white;"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <!-- Stats bar — mirrors the 3-column grid -->
                                <ui:VisualElement style="flex-direction: row; padding: 24px; border-top-width: 1px; border-top-color: rgb(229,231,235);">
                                    <ui:VisualElement style="flex: 1; align-items: center;">
                                        <ui:Label name="reps-text" text="5/10" style="font-size: 24px; -unity-font-style: bold; color: rgb(142,165,140);"/>
                                        <ui:Label text="Repetitions" class="text-sm" style="color: rgb(75,85,99);"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement style="flex: 1; align-items: center;">
                                        <ui:Label name="time-elapsed-text" text="2:34" style="font-size: 24px; -unity-font-style: bold; color: rgb(142,165,140);"/>
                                        <ui:Label text="Time Elapsed" class="text-sm" style="color: rgb(75,85,99);"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement style="flex: 1; align-items: center;">
                                        <ui:Label name="accuracy-text" text="92%" style="font-size: 24px; -unity-font-style: bold; color: rgb(142,165,140);"/>
                                        <ui:Label text="Accuracy" class="text-sm" style="color: rgb(75,85,99);"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>

                                <!-- Action buttons -->
                                <ui:VisualElement style="flex-direction: row; padding: 0 24px 24px 24px;">
                                    <ui:Button name="exit-button" text="Exit Exercise" class="btn btn-outline btn-lg" style="flex: 1; margin-right: 12px;"/>
                                    <ui:Button name="complete-button" text="Complete Exercise" class="btn btn-accent btn-lg" style="flex: 1;"/>
                                </ui:VisualElement>

                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Right 1/3 — side panel (tasks / info / default) -->
                    <ui:VisualElement style="flex: 1; flex-direction: column;">

                        <!-- TASKS PANEL -->
                        <ui:VisualElement name="tasks-panel" class="card" style="display: none; flex-direction: column;">
                            <ui:VisualElement class="card-header" style="flex-direction: row; justify-content: space-between; align-items: center;">
                                <ui:Label text="☰  Task List" class="card-title" style="flex-direction: row;"/>
                                <ui:Button name="tasks-close-btn" text="✕" class="btn btn-ghost btn-icon"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="card-content">
                                <ui:VisualElement name="task-list" style="flex-direction: column;"/>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- INFO PANEL -->
                        <ui:VisualElement name="info-panel" class="card" style="display: none; flex-direction: column;">
                            <ui:VisualElement class="card-header" style="flex-direction: row; justify-content: space-between; align-items: center;">
                                <ui:Label text="ℹ  Hints &amp; Tips" class="card-title"/>
                                <ui:Button name="info-close-btn" text="✕" class="btn btn-ghost btn-icon"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="card-content">
                                <ui:VisualElement name="hint-list" style="flex-direction: column;"/>
                                <ui:VisualElement style="margin-top: 24px; background-color: rgb(254,249,195); border-radius: 8px; padding: 16px;">
                                    <ui:Label text="💡 Remember: Consistency is key to recovery. Regular practice will yield the best results."
                                        class="text-sm" style="color: rgb(133,77,14); white-space: normal;"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- DEFAULT PANEL -->
                        <ui:VisualElement name="default-panel" class="card" style="flex-direction: column;">
                            <ui:VisualElement class="card-header">
                                <ui:Label text="Exercise Information" class="card-title"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="card-content" style="flex-direction: column;">
                                <ui:Label text="Target Areas" class="text-sm font-semibold" style="margin-bottom: 8px;"/>
                                <ui:VisualElement style="flex-direction: row; flex-wrap: wrap; margin-bottom: 24px;">
                                    <ui:Label text="Shoulder"    class="badge badge-green" style="margin-right: 8px; margin-bottom: 8px;"/>
                                    <ui:Label text="Deltoid"     class="badge badge-green" style="margin-right: 8px; margin-bottom: 8px;"/>
                                    <ui:Label text="Rotator Cuff" class="badge badge-green" style="margin-bottom: 8px;"/>
                                </ui:VisualElement>
                                <ui:Label text="Difficulty" class="text-sm font-semibold" style="margin-bottom: 8px;"/>
                                <ui:VisualElement style="flex-direction: row; margin-bottom: 4px;">
                                    <ui:VisualElement name="diff-1" style="flex: 1; height: 8px; border-radius: 4px; background-color: rgb(142,165,140); margin-right: 4px;"/>
                                    <ui:VisualElement name="diff-2" style="flex: 1; height: 8px; border-radius: 4px; background-color: rgb(142,165,140); margin-right: 4px;"/>
                                    <ui:VisualElement name="diff-3" style="flex: 1; height: 8px; border-radius: 4px; background-color: rgb(229,231,235); margin-right: 4px;"/>
                                    <ui:VisualElement name="diff-4" style="flex: 1; height: 8px; border-radius: 4px; background-color: rgb(229,231,235); margin-right: 4px;"/>
                                    <ui:VisualElement name="diff-5" style="flex: 1; height: 8px; border-radius: 4px; background-color: rgb(229,231,235);"/>
                                </ui:VisualElement>
                                <ui:Label text="Beginner" class="text-sm" style="color: rgb(75,85,99); margin-bottom: 24px;"/>
                                <ui:VisualElement style="background-color: rgb(249,250,251); border-radius: 8px; padding: 16px;">
                                    <ui:Label text="Use the toolbar buttons to access tasks, hints, and controls during your exercise."
                                        class="text-sm" style="color: rgb(75,85,99); white-space: normal;"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
